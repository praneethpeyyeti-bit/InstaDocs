{
  "name": "instadocs-vscode",
  "displayName": "InstaDocs",
  "description": "Generate a Solution Design Document + Test Case Document from an RPA/automation project.",
  "version": "0.1.7",
  "publisher": "instadocs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.com/instadocs.git"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "instadocs.welcome",
        "title": "Get Started",
        "category": "InstaDocs"
      },
      {
        "command": "instadocs.openPanel",
        "title": "Open Generator",
        "category": "InstaDocs"
      },
      {
        "command": "instadocs.generateFromWorkspace",
        "title": "Generate SDD + Test Cases",
        "category": "InstaDocs"
      },
      {
        "command": "instadocs.generateWithGateway",
        "title": "Generate SDD + Test Cases (AI · UiPath LLM Gateway)",
        "category": "InstaDocs"
      },
      {
        "command": "instadocs.generateFromGitUrl",
        "title": "Generate SDD + Test Cases from Git URL",
        "category": "InstaDocs"
      },
      {
        "command": "instadocs.setupGateway",
        "title": "Set up Gateway (org / tenant / model)",
        "category": "InstaDocs"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "instadocs.openPanel",
          "when": "explorerResourceIsFolder",
          "group": "instadocs@0"
        },
        {
          "command": "instadocs.generateFromWorkspace",
          "when": "explorerResourceIsFolder",
          "group": "instadocs@1"
        },
        {
          "command": "instadocs.generateWithGateway",
          "when": "explorerResourceIsFolder",
          "group": "instadocs@2"
        }
      ],
      "commandPalette": [
        {
          "command": "instadocs.welcome",
          "when": "true"
        },
        {
          "command": "instadocs.openPanel",
          "when": "true"
        },
        {
          "command": "instadocs.generateFromWorkspace",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "instadocs.generateWithGateway",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "instadocs.setupGateway",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "InstaDocs",
      "properties": {
        "instadocs.gateway.baseHost": {
          "type": "string",
          "default": "",
          "description": "UiPath Cloud base host, e.g. https://cloud.uipath.com or https://staging.uipath.com. Leave empty to use your signed-in `uip` session. Combined with organization + tenant to build the Gateway URL."
        },
        "instadocs.gateway.organization": {
          "type": "string",
          "default": "",
          "description": "UiPath organization LOGICAL NAME (e.g. acme), not the GUID. Leave empty to use your `uip` session."
        },
        "instadocs.gateway.tenant": {
          "type": "string",
          "default": "",
          "description": "UiPath tenant name (case-sensitive, e.g. DefaultTenant). Leave empty to use your `uip` session."
        },
        "instadocs.gateway.servicePrefix": {
          "type": "string",
          "enum": ["", "agenthub_", "orchestrator_"],
          "default": "",
          "description": "Gateway service prefix. Leave empty to auto-select (agenthub_ for *.uipath.com, else orchestrator_)."
        },
        "instadocs.gateway.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Full LLM Gateway chat/completions URL. Overrides baseHost/organization/tenant. Leave empty to auto-derive."
        },
        "instadocs.gateway.model": {
          "type": "string",
          "default": "anthropic.claude-sonnet-4-5-20250929-v1:0",
          "description": "Model id for the LLM Gateway normalized API. Sonnet 4.5 (default) is the fast/quality balance; haiku-4-5 is fastest; opus-4-8 is best quality but slowest."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node build.js",
    "watch": "node build.js --watch",
    "package": "node build.js --production && vsce package --no-dependencies --target win32-x64"
  },
  "devDependencies": {
    "@instadocs/core": "0.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.7.4",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  }
}
